# ============================================================================
# DCTX GLOBAL OMIT CONTENT RULES
# ============================================================================
#
# Files matching these patterns will APPEAR in the directory tree
# but their CONTENT will be omitted from the output.
#
# Use this for files that are useful to know exist, but whose
# contents are too large, binary, or sensitive for LLM context.
#
# Syntax: Same as .gitignore
# - One pattern per line
# - Lines starting with # are comments
# - Use ! to negate a pattern
# - Supports wildcards (* and **)
#
# To override these rules for a specific project:
# Create a .dctxignore file in your project root with !pattern
#
# ============================================================================

# ============================================================================
# VERSION CONTROL CONFIGURATION
# ============================================================================
# VCS config files - useful to see in tree, but content often verbose

.gitignore
.gitattributes
.gitmodules

