{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dctx:plugin-api:v1:requests",
  "$comment": "PL-C v1; PLUGINS.md, decision 080/decision 081. Local schema registry only. README.md and semantics.md are normative; schema validity grants no authority.",
  "$defs": {
    "initialize": {"type":"object","properties":{"identity":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/identity"},"config":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/config"},"hooks":{"type":"array","items":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/hook_decl"},"maxItems":5,"minItems":0,"uniqueItems":true},"grants":{"type":"array","items":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/grant"},"maxItems":64,"minItems":0},"resources":{"type":"array","items":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/resource"},"maxItems":128,"minItems":0},"policy_epoch":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/uint"},"plan_digest":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/digest"},"limits":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/limits"},"cancellation":{"const":true},"progress":{"const":true},"liveness":{"$ref":"urn:dctx:plugin-api:v1:dts#/$defs/liveness"}},"required":["identity","config","hooks","grants","resources","policy_epoch","plan_digest","limits","cancellation","progress","liveness"],"additionalProperties":false},
    "invoke": {"$ref":"urn:dctx:plugin-api:v1:invocation"},
    "probe": {"type":"object","properties":{"invocation":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"challenge":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"last_progress_seq":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/uint"},"wait":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/wait"}},"required":["invocation","challenge","last_progress_seq"],"additionalProperties":false},
    "cancel": {"type":"object","properties":{"invocation":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"reason":{"enum":["user","revoked","budget","stalled","shutdown","protocol-error"]}},"required":["invocation","reason"],"additionalProperties":false},
    "shutdown": {"type":"object","properties":{"reason":{"enum":["session-ended","disabled","revoked","protocol-error"]}},"required":["reason"],"additionalProperties":false},
    "output.read": {"type":"object","properties":{"handle":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"offset":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/uint"},"length":{"type":"integer","minimum":1,"maximum":65536}},"required":["handle","offset","length"],"additionalProperties":false},
    "output.list": {"type":"object","properties":{"invocation":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"cursor":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"max_items":{"type":"integer","minimum":1,"maximum":64}},"required":["invocation","cursor","max_items"],"additionalProperties":false},
    "file.read": {"type":"object","properties":{"resource":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"offset":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/uint"},"length":{"type":"integer","minimum":1,"maximum":65536},"precondition":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"}},"required":["resource","offset","length"],"additionalProperties":false},
    "file.stage": {"type":"object","properties":{"resource":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"precondition":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"upload":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"offset":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/uint"},"bytes":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/base64"},"final":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/bool"}},"required":["resource","precondition","offset","bytes","final"],"additionalProperties":false},
    "file.replace": {"type":"object","properties":{"resource":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"precondition":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"upload":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"action_id":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"}},"required":["resource","precondition","upload","action_id"],"additionalProperties":false},
    "program.run": {"type":"object","properties":{"operation":{"const":"git.add-ignore"},"args":{"type":"object","properties":{"resource":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"precondition":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"repository":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"}},"required":["resource","precondition","repository"],"additionalProperties":false},"action_id":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"}},"required":["operation","args","action_id"],"additionalProperties":false},
    "state.read": {"type":"object","properties":{"handle":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"offset":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/uint"},"length":{"type":"integer","minimum":1,"maximum":65536},"precondition":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"}},"required":["handle","offset","length"],"additionalProperties":false},
    "state.write": {"type":"object","properties":{"handle":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"precondition":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"bytes":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/base64"},"provenance":{"type":"array","items":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"maxItems":128,"minItems":0,"uniqueItems":true},"action_id":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"}},"required":["handle","precondition","bytes","provenance","action_id"],"additionalProperties":false},
    "state.reclaim": {"type":"object","properties":{"handle":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"precondition":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"action_id":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"}},"required":["handle","precondition","action_id"],"additionalProperties":false}
  }
}
