{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dctx:plugin-api:v1:results",
  "$comment": "PL-C v1; PLUGINS.md, decision 080/decision 081. Local schema registry only. README.md and semantics.md are normative; schema validity grants no authority.",
  "$defs": {
    "initialize": {"type":"object","properties":{"status":{"const":"ready"}},"required":["status"],"additionalProperties":false},
    "invoke": {"type":"object","properties":{"status":{"enum":["ok","skipped","warning"]},"reason":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/name"},"receipts":{"type":"array","items":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"maxItems":64,"minItems":0,"uniqueItems":true},"diagnostics":{"type":"array","items":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/diagnostic"},"maxItems":64,"minItems":0},"command_output":{"type":"array","items":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/command_record"},"maxItems":64,"minItems":0}},"required":["status","reason","receipts","diagnostics","command_output"],"additionalProperties":false},
    "probe": {"type":"object","properties":{"invocation":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"challenge":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"last_progress_seq":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/uint"},"state":{"enum":["running","waiting","cancelling"]},"wait":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/wait"}},"required":["invocation","challenge","last_progress_seq","state"],"additionalProperties":false},
    "cancel": {"type":"object","properties":{"accepted":{"const":true}},"required":["accepted"],"additionalProperties":false},
    "shutdown": {"type":"object","properties":{"status":{"const":"closing"}},"required":["status"],"additionalProperties":false},
    "output.read": {"type":"object","properties":{"bytes":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/base64"},"offset":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/uint"},"size":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/uint"},"eof":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/bool"},"receipt":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"}},"required":["bytes","offset","size","eof","receipt"],"additionalProperties":false},
    "output.list": {"type":"object","properties":{"outputs":{"type":"array","items":{"oneOf":[{"type":"object","properties":{"handle":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"role":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/role"},"location":{"enum":["project","outside-project","stdout","clipboard"]},"bytes":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/uint"}},"required":["handle","role","location"],"additionalProperties":false},{"type":"object","properties":{"handle":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"role":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/role"},"bytes":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/uint"}},"required":["handle","role","bytes"],"additionalProperties":false}]},"maxItems":64,"minItems":0},"next":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"}},"required":["outputs"],"additionalProperties":false},
    "file.read": {"type":"object","properties":{"bytes":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/base64"},"offset":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/uint"},"size":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/uint"},"eof":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/bool"},"precondition":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"receipt":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"}},"required":["bytes","offset","size","eof","precondition","receipt"],"additionalProperties":false},
    "file.stage": {"type":"object","properties":{"upload":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"next_offset":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/uint"},"complete":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/bool"},"receipt":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"}},"required":["upload","next_offset","complete","receipt"],"additionalProperties":false},
    "file.replace": {"type":"object","properties":{"precondition":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"receipt":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"}},"required":["precondition","receipt"],"additionalProperties":false},
    "program.run": {"type":"object","properties":{"status":{"enum":["succeeded","failed"]},"exit_code":{"type":"integer","minimum":0,"maximum":4294967295},"diagnostics":{"type":"array","items":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/diagnostic"},"maxItems":64,"minItems":0},"receipt":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"}},"required":["status","exit_code","diagnostics","receipt"],"additionalProperties":false},
    "state.read": {"type":"object","properties":{"bytes":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/base64"},"offset":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/uint"},"size":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/uint"},"eof":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/bool"},"precondition":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"receipt":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"}},"required":["bytes","offset","size","eof","precondition","receipt"],"additionalProperties":false},
    "state.write": {"type":"object","properties":{"precondition":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"},"receipt":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"}},"required":["precondition","receipt"],"additionalProperties":false},
    "state.reclaim": {"type":"object","properties":{"reclaimed_bytes":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/uint"},"receipt":{"$ref":"urn:dctx:plugin-api:v1:common#/$defs/token"}},"required":["reclaimed_bytes","receipt"],"additionalProperties":false}
  }
}
