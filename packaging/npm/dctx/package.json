{
  "name": "dctx",
  "version": "1.3.0",
  "description": "Transport-only Node.js client for the dctx engine RPC and CLI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eris-Margeta/dctx.git",
    "directory": "packaging/npm/dctx"
  },
  "homepage": "https://www.dctx.internet.technology",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "src/",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "bin": {
    "dctx": "bin/dctx.js"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@dctx/cli-linux-x64": "1.3.0",
    "@dctx/cli-linux-arm64": "1.3.0",
    "@dctx/cli-darwin-x64": "1.3.0",
    "@dctx/cli-darwin-arm64": "1.3.0",
    "@dctx/cli-win32-x64": "1.3.0"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "type": "commonjs"
}
